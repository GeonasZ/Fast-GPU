ARG NGC_IMAGE=nvcr.io/nvidia/pytorch:26.03-py3
FROM ${NGC_IMAGE}

ARG NVBANDWIDTH_REF=main

LABEL org.opencontainers.image.title="Fast GPU runtime" \
      org.opencontainers.image.description="Prebuilt Fast GPU validation and development runtime"

ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update \
 && apt-get install -y --no-install-recommends \
      ca-certificates curl jq pciutils git python3 python3-pip openssh-server iproute2 tini \
      fio iperf3 nvme-cli cmake build-essential rclone rsync \
      libboost-program-options-dev \
 && curl -fsSL https://deb.nodesource.com/setup_22.x | bash - \
 && apt-get install -y --no-install-recommends nodejs \
 && git clone --filter=blob:none https://github.com/NVIDIA/nvbandwidth.git /tmp/nvbandwidth \
 && git -C /tmp/nvbandwidth checkout "${NVBANDWIDTH_REF}" \
 && cmake -S /tmp/nvbandwidth -B /tmp/nvbandwidth/build \
      -DCMAKE_BUILD_TYPE=Release \
      -DCMAKE_CUDA_ARCHITECTURES="75;80;86;89;90;100" \
 && cmake --build /tmp/nvbandwidth/build -j"$(nproc)" \
 && install /tmp/nvbandwidth/build/nvbandwidth /usr/local/bin/nvbandwidth \
 && rm -rf /tmp/nvbandwidth /root/.npm /var/lib/apt/lists/*

RUN install -d -m 0755 /opt/fast-gpu /var/lib/fast-gpu /data/datasets/fineweb
COPY agent/agent.js /opt/fast-gpu/agent.js
COPY agent/verify-image.sh /opt/fast-gpu/verify-image.sh
COPY agent/ensure-ssh.sh /opt/fast-gpu/ensure-ssh.sh
RUN chmod 0755 /opt/fast-gpu/verify-image.sh /opt/fast-gpu/ensure-ssh.sh

EXPOSE 22 3000
HEALTHCHECK --interval=10s --timeout=3s --start-period=10s --retries=6 \
  CMD curl -fsS http://127.0.0.1:3000/health || exit 1
ENTRYPOINT ["/usr/bin/tini", "-g", "--"]
CMD ["node", "/opt/fast-gpu/agent.js"]
