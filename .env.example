PORT=4173
BASE_URL=https://gpu.example.com
PPIO_API_KEY=
# PPIO 创建接口的最低 CUDA 调度要求；CUDA 13 使用 13.0，不要写成并不存在或尚未开放的次版本
PPIO_MIN_CUDA_VERSION=13.0
HYPERSTACK_API_KEY=
HYPERSTACK_API_BASE=https://infrahub-api.nexgencloud.com/v1/
HYPERSTACK_ENVIRONMENT=
# 多区域可改用 JSON，例如 {"CANADA-1":"fleet-ca","NORWAY-1":"fleet-no"}
HYPERSTACK_ENVIRONMENTS=
HYPERSTACK_KEY_NAME=
# 必须是控制台中实际存在、Ubuntu 24.04 且名称以 with Docker 结尾的镜像
HYPERSTACK_IMAGE_NAME=
HYPERSTACK_IMAGE_USER=
# Server-side secret only. Prefer a reusable=false, pre-authorized, short-lived key.
TAILSCALE_AUTH_KEY=
# 仅允许控制面访问 Agent，例如 203.0.113.10/32
HYPERSTACK_AGENT_CIDR=
# GitHub Actions publishes this after validation. Replace owner/repository.
# Private GHCR packages require the Hyperstack VM to authenticate before docker pull.
# 唯一必需的运行时镜像配置。平台会从这里推导精确版本、stable-cuda13 和 stable-cuda12。
FLEET_RUNTIME_IMAGE_REPOSITORY=ghcr.io/owner/repository-runtime
# 可选兼容覆盖；通常无需设置。
# FLEET_CONTAINER_IMAGE_CUDA13=ghcr.io/owner/repository-runtime:stable-cuda13
# FLEET_CONTAINER_IMAGE_CUDA128=ghcr.io/owner/repository-runtime:stable-cuda12
AUTODL_TOKEN=
AUTODL_API_BASE=https://api.autodl.com
# 实验性社区镜像转存的网页报价接口；AutoDL 前端升级后可能需要调整。
AUTODL_WEB_MARKET_BASE=https://www.autodl.com
AUTODL_WEB_MARKET_PATH=/api/v1/market/list
# 可选：逗号分隔 AutoDL Pro API 的 gpu_spec_uuid；留空显示平台支持的全部 AutoDL 型号。
AUTODL_GPU_SPECS=
RUNPOD_API_KEY=
RUNPOD_API_BASE=https://rest.runpod.io/v1/
# 本地 SQLite 文件必须挂载到持久卷；正式部署建议接入 PostgreSQL 或平台已有数据库
FLEET_DATABASE_PATH=.data/fleet.sqlite
# Required: 32 random bytes encoded as base64. Generate with:
# node -e "console.log(require('node:crypto').randomBytes(32).toString('base64'))"
FLEET_CREDENTIAL_ENCRYPTION_KEY=
FLEET_AGENT_BUNDLE_URL=https://your-domain.example/gpu-fleet-agent.tar.gz
# r2 或 oss；两者同时启用时决定新实例首次同步的数据源
STORAGE_PRIMARY_PROVIDER=r2
R2_S3_ENABLED=
R2_S3_ENDPOINT=
R2_S3_BUCKET=
R2_S3_PREFIX=fineweb-edu/CC-MAIN-2013-20
R2_S3_REGION=auto
R2_S3_ACCESS_KEY_ID=
R2_S3_SECRET_ACCESS_KEY=
OSS_S3_ENABLED=
OSS_S3_ENDPOINT=https://oss-cn-hangzhou.aliyuncs.com
OSS_S3_BUCKET=
OSS_S3_PREFIX=fineweb-edu/CC-MAIN-2013-20
OSS_S3_REGION=cn-hangzhou
OSS_S3_ACCESS_KEY_ID=
OSS_S3_SECRET_ACCESS_KEY=
# 新实例首次出现后，等待 GPU 遥测上报的宽限时间（毫秒）
FLEET_TELEMETRY_GRACE_MS=10000
# 一体化客户端可选：Cloudflare 命名 Tunnel Token。命名 Tunnel 才能绑定固定域名；
# 同时将 BASE_URL 设置为该 Tunnel 中配置的固定 HTTPS 域名。
FLEET_TELEMETRY_MODE=ssh
# Web mode enables account login and registration by default.
# Set to false after creating the required accounts to close public registration.
FLEET_ALLOW_REGISTRATION=true
