PORT=4173
BASE_URL=https://gpu.example.com
PPIO_API_KEY=
# PPIO 创建接口的最低 CUDA 调度要求；CUDA 13 使用 13.0，不要写成并不存在或尚未开放的次版本
PPIO_MIN_CUDA_VERSION=13.0
HYPERSTACK_API_KEY=
HYPERSTACK_API_BASE=https://infrahub-api.nexgencloud.com/v1/
HYPERSTACK_ENVIRONMENT=
# 多区域可改用 JSON，例如 {"CANADA-1":"fleet-ca","NORWAY-1":"fleet-no"}
HYPERSTACK_ENVIRONMENTS=
HYPERSTACK_KEY_NAME=
# 必须是控制台中实际存在、Ubuntu 24.04 且名称以 with Docker 结尾的镜像
HYPERSTACK_IMAGE_NAME=
# 仅允许控制面访问 Agent，例如 203.0.113.10/32
HYPERSTACK_AGENT_CIDR=
# GitHub Actions publishes this after validation. Replace owner/repository.
# Private GHCR packages require the Hyperstack VM to authenticate before docker pull.
FLEET_CONTAINER_IMAGE_CUDA13=ghcr.io/owner/repository-runtime:stable
FLEET_CONTAINER_IMAGE_CUDA128=nvcr.io/nvidia/pytorch:25.03-py3
RUNPOD_API_KEY=
RUNPOD_API_BASE=https://rest.runpod.io/v1/
FLEET_CONTAINER_IMAGE=ghcr.io/owner/repository-runtime:stable
# 本地 SQLite 文件必须挂载到持久卷；正式部署建议接入 PostgreSQL 或平台已有数据库
FLEET_DATABASE_PATH=.data/fleet.sqlite
# Required: 32 random bytes encoded as base64. Generate with:
# node -e "console.log(require('node:crypto').randomBytes(32).toString('base64'))"
FLEET_CREDENTIAL_ENCRYPTION_KEY=
FLEET_AGENT_BUNDLE_URL=https://your-domain.example/gpu-fleet-agent.tar.gz
S3_ENDPOINT=
S3_BUCKET=
S3_PREFIX=fineweb-edu/CC-MAIN-2013-20
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
